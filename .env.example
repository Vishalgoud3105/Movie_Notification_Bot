# Copy to .env and fill in your own values. .env is gitignored - never commit it.

# From @BotFather: /mybots -> your bot -> API Token
TELEGRAM_API_TOKEN=<your-bot-token-from-botfather>
# Your numeric Telegram id. Message @userinfobot to find it.
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# --- LLM configuration ---
# The LLM understands plain-English messages and phrases replies. Optional:
# without any key the bot still watches and still answers the keyword commands
# (report/status/check/cancel), it just cannot be talked to in normal sentences.
# The LLM never decides whether tickets exist - that always comes from the site.
#
# ONE FLAG swaps which provider answers FIRST. The default is Mistral; set
# LLM_PROVIDER=groq to put Groq first. The OTHER provider is the automatic
# failover: if the first is down, throttled or its key is rejected, the bot
# moves on to the other's models - but only if that key is set below, so leave
# a key blank to turn failover off. A typo here stops the bot at startup.
LLM_PROVIDER=mistral

# Mistral key -- console.mistral.ai. Required when LLM_PROVIDER=mistral.
MISTRAL_API_KEY=<your-mistral-api-key>
# Comma list, first = primary, the rest tried in order on 429/403. On Mistral's
# FREE tier (checked 30 Sep 2026) medium/small/large get 429/403 while the
# ministral family works; 14b beat 8b on this bot's real tasks (6 Oct 2026:
# 98.8% vs 94.6%, see watcher/config.py for the measurements). With billing, put
# mistral-medium-latest first. `python watch.py --diagnose-llm` shows which
# models work for your key now. (The older MISTRAL_MODEL + MISTRAL_FALLBACK_MODELS
# pair still works; this line wins if both are set.)
MISTRAL_MODELS=ministral-14b-2512,ministral-8b-2512
MISTRAL_TOKENS_PER_MINUTE=500000

# Groq key -- console.groq.com. Required when LLM_PROVIDER=groq; also enables
# Groq as the failover when Mistral is first.
GROQ_API_KEY=<your-groq-api-key>
# gpt-oss-* are reasoning models: the bot sends them reasoning_effort=low and a
# 1500-token floor so the thinking doesn't eat the whole answer budget.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# 8000 = Groq's free tier. Groq counts input + the reserved max_tokens against
# it, so the bot shrinks max_tokens to fit. Raise it the day your plan changes.
GROQ_TOKENS_PER_MINUTE=8000

# Which ticketing site to read: district | bms
# BookMyShow returns 403 to every datacenter IP (verified on GitHub Actions and
# Oracle Cloud), so "district" is the only source that works from a server.
SOURCE=district

# The District movie page. Find it at district.in and copy the city-specific
# URL, e.g. .../movies/<slug>-movie-tickets-in-<city>-MV<id>
# When you set a watch by chat instead, this is looked up for you.
DISTRICT_URL=<https://www.district.in/movies/...-in-<city>-MV000000>

# Used when a chat request names no city. Without it District serves a page
# resolved by geolocation, which from a cloud VM silently picks the wrong city.
HOME_CITY=<e.g. hyderabad>

# Dates to watch, YYYYMMDD, comma separated
DATES=<YYYYMMDD,YYYYMMDD>

# Only report shows starting inside this window, 24h clock, local (IST) time
TIME_FROM=<HH:MM>
TIME_TO=<HH:MM>

# Matched against the screen format with punctuation ignored, so "4DX 3D"
# matches District's "4DX-3D". Blank = any format.
FORMAT=<e.g. 4DX 3D>
LANGUAGE=<e.g. English>

# Only these venues (substring match, comma separated). Blank = every cinema.
VENUES=<e.g. Irrum Manzil>

# Free-text seat tier to filter for (substring match against the cinema's own
# category label, e.g. "recliner" matches "RECLINER ROWS"). Every cinema names
# its own tiers, so this isn't a fixed list. Blank = any category.
SEAT_CATEGORY=<e.g. recliner>

# Shown in the alert text
MOVIE_NAME=<Movie Name For The Message>

# --- Only used when SOURCE=bms ------------------------------------------------
# The BMS code for the FORMAT you want, not the movie's parent code: the parent
# returns only 2D shows, and each format is its own event.
EVENT_CODE=<ET00xxxxxx>
REGION_CODE=<your-city-code>
MOVIE_SLUG=<movie-name-in-bms-url>
