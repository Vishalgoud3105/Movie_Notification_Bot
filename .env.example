# Copy to .env and fill in your own values. .env is gitignored - never commit it.

# From @BotFather: /mybots -> your bot -> API Token
TELEGRAM_API_TOKEN=<your-bot-token-from-botfather>
# Your numeric Telegram id. Message @userinfobot to find it.
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# The BMS code for the FORMAT you want, not the movie's parent code.
# The parent returns only 2D shows - each format is its own event.
EVENT_CODE=<ET00xxxxxx>
# City code, e.g. HYD, BLR, MUMBAI
REGION_CODE=<your-city-code>
# Dates to watch, YYYYMMDD, comma separated
DATES=<YYYYMMDD,YYYYMMDD>

# Only report shows starting inside this window, 24h clock
TIME_FROM=<HH:MM>
TIME_TO=<HH:MM>

# Substring matches against the show's format and language. Blank = any.
FORMAT=<e.g. 4DX 3D>
LANGUAGE=<e.g. English>

# Used only for the booking link in the alert (from the BMS movie URL)
MOVIE_SLUG=<movie-name-in-bms-url>
MOVIE_NAME=<Movie Name For The Message>

# Optional: only these venues (substring match, comma separated). Empty = all.
VENUES=
