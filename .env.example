# Copy to .env and fill in your own values. .env is gitignored - never commit it.

# From @BotFather: /mybots -> your bot -> API Token
TELEGRAM_API_TOKEN=<your-bot-token-from-botfather>
# Your numeric Telegram id. Message @userinfobot to find it.
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# Groq, for understanding plain-English messages and phrasing replies.
# Get one free at console.groq.com/keys. Optional: without it the bot still
# watches and still answers the keyword commands (report/status/check/cancel),
# it just cannot be talked to in normal sentences.
# The LLM never decides whether tickets exist - that always comes from the site.
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# Which ticketing site to read: district | bms
# BookMyShow returns 403 to every datacenter IP (verified on GitHub Actions and
# Oracle Cloud), so "district" is the only source that works from a server.
SOURCE=district

# The District movie page. Find it at district.in and copy the city-specific
# URL, e.g. .../movies/<slug>-movie-tickets-in-<city>-MV<id>
# When you set a watch by chat instead, this is looked up for you.
DISTRICT_URL=<https://www.district.in/movies/...-in-<city>-MV000000>

# Used when a chat request names no city. Without it District serves a page
# resolved by geolocation, which from a cloud VM silently picks the wrong city.
HOME_CITY=<e.g. hyderabad>

# Dates to watch, YYYYMMDD, comma separated
DATES=<YYYYMMDD,YYYYMMDD>

# Only report shows starting inside this window, 24h clock, local (IST) time
TIME_FROM=<HH:MM>
TIME_TO=<HH:MM>

# Matched against the screen format with punctuation ignored, so "4DX 3D"
# matches District's "4DX-3D". Blank = any format.
FORMAT=<e.g. 4DX 3D>
LANGUAGE=<e.g. English>

# Only these venues (substring match, comma separated). Blank = every cinema.
VENUES=<e.g. Irrum Manzil>

# Shown in the alert text
MOVIE_NAME=<Movie Name For The Message>

# --- Only used when SOURCE=bms ------------------------------------------------
# The BMS code for the FORMAT you want, not the movie's parent code: the parent
# returns only 2D shows, and each format is its own event.
EVENT_CODE=<ET00xxxxxx>
REGION_CODE=<your-city-code>
MOVIE_SLUG=<movie-name-in-bms-url>
